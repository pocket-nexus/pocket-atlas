; Planar wet surfaces: projective reflection, source albedo and a world-space
; puddle mask. Full writes include unused output components for real PICA.
.constf constants(0.0, 1.0, 0.00392156862745, 0.5)
.fvec projection[4]
.fvec model[3]
.fvec tint
.fvec reflected[4]
.fvec eye
.fvec wet
.fvec uv_transform
.in inpos v0
.in intex v1
.in inclr v2
.out outpos position
.out outreflect texcoord0.xy
.out - texcoord0w outreflect.z
.out outtex texcoord1
.out outwet texcoord2
.out outclr color
.entry main
.proc main
    mov r0.xyz, inpos
    mov r0.w, constants.y
    dp4 r1.x, model[0], r0
    dp4 r1.y, model[1], r0
    dp4 r1.z, model[2], r0
    mov r1.w, constants.y
    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1
    dp4 r3.x, reflected[0], r1
    dp4 r3.y, reflected[1], r1
    dp4 r3.w, reflected[3], r1
    add r4.xy, r3.xy, r3.ww
    mul r4.xy, constants.ww, r4.xy
    mov r4.z, r3.w
    mov r4.w, constants.y
    mov outreflect, r4
    mul r0.xy, uv_transform.xy, intex.xy
    add r0.xy, uv_transform.zw, r0.xy
    mov r0.zw, intex.zw
    mov outtex, r0
    mul r5.xy, wet.zz, r1.xz
    mov r5.zw, constants.xy
    mov outwet, r5
    ; Schlick-style grazing boost, with the authored puddle coverage in wet.x.
    add r6.xyz, eye.xyz, -r1.xyz
    dp3 r6.w, r6, r6
    rsq r6.w, r6.w
    mul r6.y, r6.y, r6.w
    max r6.y, -r6.y, r6.y
    min r6.y, constants.y, r6.y
    add r6.y, constants.y, -r6.y
    mul r6.y, r6.y, r6.y
    mul r6.y, wet.y, r6.y
    add r6.y, wet.x, r6.y
    mul r2, constants.zzzz, inclr
    mul r2.xyz, tint, r2
    mov r2.w, r6.y
    mov outclr, r2
    end
.end
