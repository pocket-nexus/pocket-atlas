; 24 byte stride: float3 position, float2 UV, ubyte4 colour. Write every
; component of each mapped output exactly once, including unused UV z/w.
.fvec projection[4]
.constf byte_scale(0.003921568627, 0.003921568627, 0.003921568627, 0.003921568627)
.in inpos v0
.in intex v1
.in inclr v2
.out outpos position
.out outtex texcoord0
.out outclr color
.entry main
.proc main
    dp4 outpos.x, projection[0], inpos
    dp4 outpos.y, projection[1], inpos
    dp4 outpos.z, projection[2], inpos
    dp4 outpos.w, projection[3], inpos
    mov outtex, intex
    mul outclr, byte_scale, inclr
    end
.end
