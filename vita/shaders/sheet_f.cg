// Far rain curtain on a camera-centred cylinder: streak columns scrolling
// down at two speeds. Additive.

uniform float4 uEye;    // camera position, time
uniform float4 uColor;  // colour, opacity

float sHash(float2 p)
{
    float3 p3 = frac(p.xyx * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float layer(float2 uv, float speed, float cols)
{
    float col = floor(uv.x * cols);
    float h = sHash(float2(col, 1.0));
    float s = uv.y * 0.6 + uEye.w * speed * (0.8 + 0.4 * h) + h * 11.0;
    float y = frac(s);
    float streak = smoothstep(0.0, 0.08, y) * smoothstep(0.35, 0.1, y);
    float xw = abs(frac(uv.x * cols) - 0.5);
    return streak * smoothstep(0.22, 0.0, xw) * step(0.55, sHash(float2(col, floor(s))));
}

// atan2 to within 0.0015 rad: the columns only need a continuous angle.
float atan2Fast(float y, float x)
{
    float ax = abs(x);
    float ay = abs(y);
    float a = min(ax, ay) / max(max(ax, ay), 1e-6);
    float r = a * (0.7853982 - (a - 1.0) * (0.2447 + 0.0663 * a));
    r = ay > ax ? 1.5707963 - r : r;
    r = x < 0.0 ? 3.1415927 - r : r;
    return y < 0.0 ? -r : r;
}

float4 main(float3 vWorld : TEXCOORD0) : COLOR
{
    float2 d = vWorld.xz - uEye.xz;
    float ang = atan2Fast(d.y, d.x);
    float2 uv = float2(ang * 6.0, vWorld.y * 0.35);
    float r = layer(uv, 1.6, 30.0) + layer(uv * 1.7 + 3.0, 2.1, 30.0) * 0.7;
    float fadeY = smoothstep(-1.0, 3.0, vWorld.y) * (1.0 - smoothstep(12.0, 22.0, vWorld.y));
    float a = r * uColor.w * fadeY;
    return float4(uColor.rgb * a, a);
}
