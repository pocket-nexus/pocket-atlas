// Lit surface: three.js physical shading (Lambert + GGX, split-sum IBL from
// the octahedral environment), rain film, puddles with ripples and the
// planar street reflection, FogExp2. Writes HDR radiance and, in alpha, the
// eye distance the haze pass integrates to; blended materials write their
// opacity there instead (the blend keeps the destination's distance).
//
// Defines: LIGHTS (0..4), ALBEDO_MAP, NORMAL_MAP, ORM_MAP, EMISSION_MAP,
// VERTEX_COLOR, VERTEX_PBR (solid roughness/metalness in UV), ALPHA_TEST,
// BLEND (alpha-blended), WET, PLANAR, DAMP,
// CLEARCOAT, INTERIOR, FOG,
// REFLECTION (mirror pass: cheaper film, no planar lookup), BAKED (static
// diffuse lighting from the vertices; LIGHTS then counts moving lights only),
// VERTEX_LIGHTS (lights evaluated per vertex, added to the irradiance),
// LITE (no normal, ORM or streak maps), FAR (LITE beyond the detail
// distance, without environment specular off the wet ground), SUN (a
// directional light per pixel with the sun's shadow map; not in the bake;
// FAR draws, outside the map's reach, skip the lookup), SUN_SPEC (its
// highlight, for smooth or metallic materials).

#include "common.cgh"

// The mirror pass lands in a half-resolution, blurred buffer: diffuse and
// emission are all that survive. Far draws keep their wet reflections but
// drop per-pixel detail smaller than a few pixels at that distance.
#if defined(REFLECTION) || defined(FAR) || defined(LITE)
#undef NORMAL_MAP
#undef ORM_MAP
#undef DAMP
#undef CLEARCOAT
#endif
#ifdef REFLECTION
#undef WET
#undef PLANAR
#define NO_SPECULAR
#endif
#if defined(FAR) && !defined(WET)
#define NO_SPECULAR
#endif

uniform sampler2D uAlbedo;
uniform sampler2D uNormalMap;
uniform sampler2D uOrm;
uniform sampler2D uEmission;
uniform sampler2D uEnv;
uniform sampler2D uPuddles;
uniform sampler2D uRipples;
uniform sampler2D uReflSharp;
uniform sampler2D uReflBlur;

uniform float4 uBase;       // linear albedo, opacity
uniform float4 uEmissive;   // linear HDR emission, alpha-test threshold
uniform float4 uPbr;        // roughness, metalness, normal scale, AO strength
uniform float4 uEnvK;       // env intensity, clearcoat, clearcoat roughness, rain
uniform float4 uWet;        // puddles, darken, roughness factor, ripple strength
uniform float4 uWet2;       // 1 / puddle scale, damp darken, damp roughness, damp streaks
uniform float4 uEye;        // camera position, time (s)
uniform float4 uFog;        // FogExp2 colour, density
uniform float4 uHemiSky;    // hemisphere irradiance from above
uniform float4 uHemiGround; // … and from below
uniform float4 uRipple;     // frame a, frame b, blend, 1 / tile (m)
uniform float4 uReflOn;     // planar weight, -, -, -
#ifdef SUN
uniform sampler2D uShadow;
uniform float4 uSunDir;    // direction towards the sun, -
uniform float4 uSunRad;    // radiance (colour × intensity), normal offset (m)
uniform float4 uSunMat[2]; // world → shadow-map uv
uniform float4 uShadowK;   // near-plane distance along the light, 1 / range, bias, map size (texels)
#ifdef MOVING_SHADOW
uniform sampler2D uMovingShadow;
uniform float4 uMovingShadowK; // same depth range and UV projection, smaller moving map
#endif

// Orthographic distance stored as R32F and sampled without filtering.
float shadowDepth(float2 uv)
{
    return tex2D(uShadow, uv).r;
}

// Share of the sun that reaches `sp`: the four map texels around it
// compared and blended by the position between their centres (what a
// hardware PCF lookup does), so shadow edges do not step with the texels.
half sunLit(float3 sp)
{
    // Keep light-space coordinates and depth comparisons in float. Only
    // bounded comparison results and filter weights use half precision.
    float4 wp = float4(sp, 1.0);
    float2 mapUv = float2(dot(uSunMat[0], wp), dot(uSunMat[1], wp));
    if (mapUv.x < 0.0 || mapUv.y < 0.0 || mapUv.x > 1.0 || mapUv.y > 1.0) return (half)1.0;
    float depth = (-dot(uSunDir.xyz, sp) - uShadowK.x) * uShadowK.y;
    half lit = (half)1.0;
#ifndef FAR
    float2 t = mapUv * uShadowK.w - 0.5;
    float2 f = frac(t);
    float2 uv = (t - f + 0.5) / uShadowK.w;
    float o = 1.0 / uShadowK.w;
    float d = depth - uShadowK.z;
    half s00 = (half)step(d, shadowDepth(uv));
    half s10 = (half)step(d, shadowDepth(uv + float2(o, 0.0)));
    half s01 = (half)step(d, shadowDepth(uv + float2(0.0, o)));
    half s11 = (half)step(d, shadowDepth(uv + float2(o, o)));
    lit = lerp(lerp(s00, s10, (half)f.x), lerp(s01, s11, (half)f.x), (half)f.y);
#endif
#ifdef MOVING_SHADOW
    if (lit <= (half)0.0) return (half)0.0;
    float2 mt = mapUv * uMovingShadowK.w - 0.5;
    float2 mf = frac(mt);
    float2 muv = (mt - mf + 0.5) / uMovingShadowK.w;
    float mo = 1.0 / uMovingShadowK.w;
    float md = depth - uMovingShadowK.z;
    half m00 = (half)step(md, tex2D(uMovingShadow, muv).r);
    half m10 = (half)step(md, tex2D(uMovingShadow, muv + float2(mo, 0.0)).r);
    half m01 = (half)step(md, tex2D(uMovingShadow, muv + float2(0.0, mo)).r);
    half m11 = (half)step(md, tex2D(uMovingShadow, muv + float2(mo, mo)).r);
    lit = min(lit, lerp(lerp(m00, m10, (half)mf.x), lerp(m01, m11, (half)mf.x), (half)mf.y));
#endif
    return lit;
}
#endif
#if LIGHTS > 0
uniform float4 uLightPos[LIGHTS];   // position, 1 / range
uniform float4 uLightCol[LIGHTS];   // radiant intensity, spot offset
uniform float4 uLightDir[LIGHTS];   // emission direction, spot scale
uniform float4 uLightRight[LIGHTS]; // rect width axis, half width
uniform float4 uLightUp[LIGHTS];    // rect height axis, half height
#endif

// One frame of the ripple flipbook (4×4 atlas, frames laid out row-major).
half2 rippleFrame(float2 uv, float frame)
{
    float2 cell = float2(fmod(frame, 4.0), floor(frame * 0.25));
    float2 local = clamp(frac(uv), 0.004, 0.996);
    return (half2)(tex2D(uRipples, (cell + local) * 0.25).rg * 2.0 - 1.0);
}

half4 main(
    float3 vWorld : TEXCOORD0,
    half3 vNormal : TEXCOORD1,
#ifdef NORMAL_MAP
    half4 vTangent : TEXCOORD2,
#endif
#if defined(PLANAR) && !defined(REFLECTION)
    float4 vScreen : TEXCOORD4,
#endif
#if defined(BAKED) || defined(VERTEX_LIGHTS)
    half3 vLight : TEXCOORD5,
#endif
#ifdef VERTEX_COLOR
    half4 vColor : COLOR0,
#endif
    float2 vUv : TEXCOORD3) : COLOR
{
    // World positions, texture coordinates and distances stay float; the
    // shading itself runs in half precision (twice the ALU rate on SGX).
    float3 toEye = uEye.xyz - vWorld;
    float dist = length(toEye);
    half3 V = (half3)(toEye / dist);
    half3 Ng = normalize(vNormal);
    half rain = (half)uEnvK.w;

#if defined(LITE) && defined(WET) && defined(PLANAR) && defined(BAKED) && !defined(REFLECTION)
    // Wet ground at 60 fps: baked light × albedo, the puddle mask, one tap of
    // the mirror image with the split-sum Fresnel, fog. No environment
    // lookup or ripple flipbook.
    {
        half4 a = (half4)uBase;
#ifdef ALBEDO_MAP
        half4 at = tex2D(uAlbedo, vUv);
        a *= half4(srgbToLinear(at.rgb), at.a);
#endif
#ifdef VERTEX_COLOR
        a *= half4(srgbToLinear(vColor.rgb), vColor.a);
#endif
        half2 pf = tex2D(uPuddles, vWorld.xz * uWet2.x).rg;
        half field = pf.r * 0.8 + pf.g * 0.2;
        half thr = (half)(0.71 - uWet.x * 0.25);
        half puddle = smoothstep(thr - (half)0.012, thr + (half)0.03, field) * rain * (half)step(0.001, uWet.x);
        a.rgb *= lerp((half)1.0, (half)uWet.y, rain);
        a.rgb = lerp(a.rgb, a.rgb * (half)0.45, puddle);
        half rough = lerp((half)uPbr.x, (half)(uPbr.x * uWet.z), rain);
        rough = lerp(rough, (half)0.02, puddle);
        float2 ruv = vScreen.xy / vScreen.w * float2(0.5, -0.5) + 0.5;
        ruv += (float2)((pf - (half)0.5) * lerp((half)0.012, (half)0.004, puddle));
        half3 refl = rough < (half)0.15 ? (half3)tex2D(uReflSharp, ruv).rgb : (half3)tex2D(uReflBlur, ruv).rgb;
        half2 e2 = (half2)saturate(min(ruv, 1.0 - ruv) * 33.3);
        half w = (half)uReflOn.x * ((half)1.0 - smoothstep((half)0.5, (half)0.8, rough)) * lerp((half)0.35, (half)1.0, e2.x * e2.y);
        // Split-sum Fresnel for the roughness (rough asphalt reflects little
        // even at grazing angles); off the mirror, the dim sky irradiance.
        half2 dfg = DFGApprox(rough, saturate(V.y));
        half3 sky = (half3)uHemiSky.rgb * (half)uEnvK.x;
        half3 color = vLight * a.rgb + lerp(sky, refl, w) * ((half)0.04 * dfg.x + dfg.y) + (half3)uEmissive.rgb;
#ifdef FOG
        color = lerp(color, (half3)uFog.rgb, (half)fogFactor(dist, uFog.w));
#endif
#ifdef BLEND
        return half4(color, a.a);
#else
        return half4(color, (half)dist);
#endif
    }
#endif

    // ------------------------------------------------------------ material
    half4 albedo = (half4)uBase;
#ifdef ALBEDO_MAP
    half4 at = tex2D(uAlbedo, vUv);
    albedo *= half4(srgbToLinear(at.rgb), at.a);
#endif
#ifdef VERTEX_COLOR
    albedo *= half4(srgbToLinear(vColor.rgb), vColor.a);
#endif
#ifdef ALPHA_TEST
    if (albedo.a < (half)uEmissive.w) discard;
#endif
    half roughness = (half)uPbr.x;
    half metalness = (half)uPbr.y;
#ifdef VERTEX_PBR
    // Solid-material batches carry each surface's constants through UVs.
    // Keep them in FAR/LITE too: their values are not a texture average.
    roughness = (half)saturate(vUv.x);
    metalness = (half)saturate(vUv.y);
#endif
#ifdef ORM_MAP
    half3 orm = tex2D(uOrm, vUv).rgb;
    roughness *= orm.g;
    metalness *= orm.b;
    half ao = (orm.r - 1.0) * (half)uPbr.w + 1.0;
#else
    // Without the map (or with it dropped) the renderer passes roughness and
    // metalness already scaled by its means, and the occlusion in w.
    half ao = (half)uPbr.w;
#endif

    half3 N = Ng;
#ifdef NORMAL_MAP
    {
        half2 nm = (tex2D(uNormalMap, vUv).rg * 2.0 - 1.0) * (half)uPbr.z;
        half nz = sqrt(saturate(1.0 - dot(nm, nm)));
        half3 T = normalize(vTangent.xyz);
        half3 B = cross(Ng, T) * vTangent.w;
        N = normalize(T * nm.x + B * nm.y + Ng * nz);
    }
#endif

    // ------------------------------------------------------------ rain film
#ifdef WET
    half puddle = 0.0;
    half3 wetN = half3(0.0, 1.0, 0.0);
    {
        half2 pf = tex2D(uPuddles, vWorld.xz * uWet2.x).rg;
        half field = pf.r * 0.8 + pf.g * 0.2;
        half thr = (half)(0.71 - uWet.x * 0.25);
        puddle = smoothstep(thr - 0.012, thr + 0.03, field) * rain * (half)step(0.001, uWet.x);
        half damp = smoothstep(thr - 0.09, thr, field);
        albedo.rgb *= lerp((half)1.0, (half)uWet.y, rain) * lerp((half)1.0, (half)0.82, damp * rain);
        albedo.rgb = lerp(albedo.rgb, albedo.rgb * (half)0.45 + half3(0.002, 0.0025, 0.003), puddle);
        half2 rip = 0.0;
#if !defined(REFLECTION) && !defined(FAR)
        if (puddle > 0.01) {
            float2 ua = vWorld.xz * uRipple.w;
            rip = rippleFrame(ua, uRipple.x) * (half)1.4 * rain;
        }
#endif
        half2 micro = (pf - 0.5) * 0.06;
        half ws = (half)uWet.w;
        wetN = normalize(half3(-(rip.x * ws + micro.x), 1.0, -(rip.y * ws + micro.y)));
        roughness = lerp(roughness, roughness * (half)uWet.z, rain);
        roughness = lerp(roughness, (half)0.02, puddle);
        N = normalize(lerp(N, wetN, puddle * (half)0.96));
    }
#endif
#ifdef DAMP
    {
        float u = vWorld.x + vWorld.z;
        half lane = tex2D(uPuddles, float2(u * 1.75, vWorld.y * 0.0875)).r;
        half lane2 = tex2D(uPuddles, float2(u * 4.75 + 0.75, vWorld.y * 0.2 - uEye.w * 0.0125)).g;
        half streak = smoothstep((half)0.55, (half)0.85, lane) * (0.6 + 0.4 * lane2) * (half)uWet2.w;
        albedo.rgb *= lerp((half)1.0, (half)uWet2.y, rain) * (1.0 - streak * (half)0.35 * rain);
        roughness = lerp(roughness, roughness * (half)uWet2.z, rain);
        roughness = lerp(roughness, (half)0.12, streak * rain);
    }
#endif

    roughness = clamp(roughness, (half)0.0525, (half)1.0);
    half3 diffuseColor = albedo.rgb * (1.0 - metalness);
    half3 specularColor = lerp(half3(0.04, 0.04, 0.04), albedo.rgb, metalness);
    half dotNV = saturate(dot(N, V));

    // ------------------------------------------------------------ direct
    half3 diffuse = 0.0;
    half3 specular = 0.0;
#if LIGHTS > 0 && !defined(INTERIOR) && defined(BAKED)
    {
        // Moving lights on baked surfaces (a passing car's headlights):
        // points and spots, Lambert and a Blinn-Phong lobe for the wet sheen,
        // in half precision after the float light vector. The float GGX loop
        // took 45 temporaries against the wet shader's 17, and with them most
        // of the pixels in flight (13 ms at 480×272 for one light).
        half e = min((half)2.0 / max(roughness * roughness * roughness * roughness, (half)0.001), (half)1024.0);
        half norm = (e + (half)8.0) * (half)(1.0 / 25.13274);
        for (int i = 0; i < LIGHTS; i++) {
            half3 Lv = (half3)(uLightPos[i].xyz - vWorld);
            half d2 = max(dot(Lv, Lv), (half)0.01);
            half il = rsqrt(d2);
            half3 L = Lv * il;
            half s = saturate(dot(-L, (half3)uLightDir[i].xyz) * (half)uLightDir[i].w + (half)uLightCol[i].w);
            half x = d2 * (half)(uLightPos[i].w * uLightPos[i].w);
            half wr = saturate((half)1.0 - x * x);
            half3 E = (half3)uLightCol[i].rgb * (wr * wr * s * s * ((half)3.0 - (half)2.0 * s) * il * il * saturate(dot(N, L)));
            half nh = saturate(dot(N, normalize(L + V)));
            diffuse += E * diffuseColor * (half)INV_PI;
            // nh^e as exp2(e·log2 nh), with log nh ≈ nh − 1 near the peak.
            specular += E * specularColor * (norm * exp2(e * (half)1.4427 * (nh - (half)1.0)));
        }
    }
#elif LIGHTS > 0 && !defined(INTERIOR)
    {
        float alpha = roughness * roughness;
        float3 d3 = 0.0;
        float3 s3 = 0.0;
        for (int i = 0; i < LIGHTS; i++) {
            float3 P = uLightPos[i].xyz;
            float3 d = vWorld - P;
            float4 R = uLightRight[i];
            float4 U = uLightUp[i];
            float3 q = P + R.xyz * clamp(dot(d, R.xyz), -R.w, R.w) + U.xyz * clamp(dot(d, U.xyz), -U.w, U.w);
            float3 Lv = q - vWorld;
            float d2 = dot(Lv, Lv);
            float3 L = Lv * rsqrt(max(d2, 1e-6));
            float s = saturate(dot(-L, uLightDir[i].xyz) * uLightDir[i].w + uLightCol[i].w);
            s = s * s * (3.0 - 2.0 * s);
            float att = distanceFalloff(d2 + R.w * U.w, uLightPos[i].w) * s;
            directLight(L, uLightCol[i].rgb * att, (float3)N, (float3)V, diffuseColor, specularColor, alpha, d3, s3);
        }
        diffuse = (half3)d3;
        specular = (half3)s3;
    }
#endif

#ifdef SUN
    {
        float3 L = uSunDir.xyz;
        half ndl = saturate(dot(N, (half3)L));
        // Both Lambert and GGX are multiplied by ndl. Back-facing surfaces
        // therefore need neither the static nor the moving shadow lookup.
        if (ndl > (half)0.0) {
#if defined(FAR) && !defined(MOVING_SHADOW)
            half lit = (half)1.0;
#else
            // Offset along the geometric normal against self-shadowing acne.
            half lit = sunLit(vWorld + (float3)Ng * uSunRad.w);
#endif
            half3 E = (half3)uSunRad.rgb * (lit * ndl);
            diffuse += E * (half)INV_PI * diffuseColor;
#if defined(SUN_SPEC) && !defined(NO_SPECULAR)
            // Palette factors select features; actual surface properties
            // came from UVs above. Apply the same lobe selection that the
            // renderer uses for individual solid materials before batching.
            if (lit > 0.0
#ifdef VERTEX_PBR
                && (roughness < (half)0.6 || metalness > (half)0.3)
#endif
            ) {
                float3 H = normalize(L + (float3)V);
                float alpha = (float)(roughness * roughness);
                float dotNV = saturate(dot((float3)N, (float3)V));
                specular += (half3)(E * (float3)F_Schlick(specularColor, (half)saturate(dot((float3)V, H))) * (V_GGX_SmithCorrelated(alpha, (float)ndl, dotNV) * D_GGX(alpha, saturate(dot((float3)N, H)))));
            }
#endif
        }
    }
#endif

    // ------------------------------------------------------------ indirect
    half envK = (half)uEnvK.x;
#ifdef BAKED
    // Static lights, hemisphere and environment diffuse, already over π.
    half3 irradiance = vLight;
#else
    half3 irradiance = lerp((half3)uHemiGround.rgb, (half3)uHemiSky.rgb, N.y * 0.5 + 0.5) * (half)INV_PI;
    irradiance += tex2Dlod(uEnv, float4(octUv((float3)N), 0.0, 5.0)).rgb * envK;
#ifdef VERTEX_LIGHTS
    // Lights evaluated per vertex (diffuse, already over π).
    irradiance += vLight;
#endif
#endif
#ifdef NO_SPECULAR
    half3 color = diffuse + irradiance * diffuseColor * ao;
#else
    half3 R = reflect(-V, N);
    half3 radiance = tex2Dlod(uEnv, float4(octUv((float3)R), 0.0, roughness * 5.0)).rgb * envK;
#if defined(PLANAR) && !defined(REFLECTION)
    {
        float2 ruv = vScreen.xy / vScreen.w * float2(0.5, -0.5) + 0.5;
        half3 nW = normalize(lerp(half3(0.0, 1.0, 0.0), wetN, max(puddle, (half)0.35)));
        ruv += (float2)nW.xz * float2(0.05, 0.09);
        // One tap: the sharp mirror for puddles and polished surfaces, its
        // blurred copy for rough wet asphalt.
        half3 refl = roughness < (half)0.15 ? (half3)tex2D(uReflSharp, ruv).rgb : (half3)tex2D(uReflBlur, ruv).rgb;
        half2 e2 = (half2)saturate(min(ruv, 1.0 - ruv) * 33.3);
        half w = (half)uReflOn.x * (1.0 - smoothstep((half)0.5, (half)0.8, roughness)) * lerp((half)0.35, (half)1.0, e2.x * e2.y);
        radiance = lerp(radiance, refl, w);
    }
#endif
    half2 dfg = DFGApprox(roughness, dotNV);
    half3 specEnv = specularColor * dfg.x + dfg.y;
    half3 color = diffuse + specular + irradiance * diffuseColor * ao + radiance * specEnv * ao;
#endif

#ifdef CLEARCOAT
    {
        half fc = F_Schlick(half3(0.04, 0.04, 0.04), dotNV).x * (half)uEnvK.y;
        half3 cc = tex2Dlod(uEnv, float4(octUv((float3)reflect(-V, Ng)), 0.0, uEnvK.z * 5.0)).rgb * envK;
        color = color * (1.0 - fc) + cc * fc;
    }
#endif

    half3 emission = (half3)uEmissive.rgb;
#ifdef EMISSION_MAP
    emission *= srgbToLinear(tex2D(uEmission, vUv).rgb);
#endif
    color += emission;

#if defined(FOG) && !defined(INTERIOR)
    color = lerp(color, (half3)uFog.rgb, (half)fogFactor(dist, uFog.w));
#endif
#if defined(BLEND)
    return half4(color, albedo.a);
#elif defined(REFLECTION)
    return half4(color, 1.0);
#else
    return half4(color, (half)dist);
#endif
}
