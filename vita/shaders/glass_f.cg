// Storefront glass, premultiplied: specular (lights + environment) at full
// strength, tint scaled by coverage, rain beads and running drops bending
// the normal. Blend: ONE, ONE_MINUS_SRC_ALPHA on colour; destination alpha
// (eye distance) is preserved.
//
// Defines: LIGHTS, FOG, VISTA (the vista haze, its inscatter × coverage, in
// place of the fog), REFLECTION, BAKED (static diffuse lighting from the
// vertices; LIGHTS then counts moving lights only), LITE and FAR (bead
// coverage only: no running drops, no bent normal, Schlick Fresnel).

#include "common.cgh"

uniform sampler2D uEnv;
uniform sampler2D uBeads;
#ifdef DISPLAY_COLOR
uniform sampler2D uDisplayEnv;
uniform half4 uDisplayFog;
uniform half4 uDisplayHaze;
uniform half4 uAtlasBlack;
#endif
uniform float4 uBase;     // linear tint, opacity
uniform float4 uPbr;      // roughness, metalness, -, -
uniform float4 uEnvK;     // env intensity, drops, -, rain
uniform float4 uEye;
uniform float4 uFog;
uniform float4 uHemiSky;
uniform float4 uHemiGround;
#if LIGHTS > 0
uniform float4 uLightPos[LIGHTS];
uniform float4 uLightCol[LIGHTS];
uniform float4 uLightDir[LIGHTS];
uniform float4 uLightRight[LIGHTS];
uniform float4 uLightUp[LIGHTS];
#endif

half4 main(
    float3 vWorld : TEXCOORD0,
#ifdef DISPLAY_COLOR
    half4 vColor : COLOR0,
#endif
#ifdef BAKED
    half3 vLight : TEXCOORD5,
#endif
#if defined(VISTA) && !defined(DISPLAY_COLOR)
    half4 vHaze : TEXCOORD7,
#endif
    half3 vNormal : TEXCOORD1) : COLOR
{
    float3 toEye = uEye.xyz - vWorld;
    float dist = length(toEye);
    half3 V = (half3)(toEye / dist);
    half3 N = normalize(vNormal);
    if (dot(N, V) < 0.0) N = -N;

    half drop = 0.0;
#ifndef NO_DROPS
#if defined(LITE) || defined(FAR)
    {
        float2 guv = abs(N.x) > abs(N.z) ? vWorld.zy : vWorld.xy;
        drop = saturate(tex2D(uBeads, guv).b * (half)(uEnvK.w * uEnvK.y));
    }
#elif !defined(REFLECTION)
    {
        bool xFacing = abs(N.x) > abs(N.z);
        float2 guv = xFacing ? vWorld.zy : vWorld.xy;
        half3 b = tex2D(uBeads, guv).rgb;
        half3 beads = half3((b.xy - 0.5) * 4.0, b.z);
        // Running drops: the bead pattern stretched and scrolled down.
        half3 r = tex2D(uBeads, guv * float2(1.3, 0.35) + float2(0.0, uEye.w * 0.09)).rgb;
        half3 runs = half3((r.xy - 0.5) * 2.5, r.z * 0.6);
        half3 all = (beads + runs) * (half)(uEnvK.w * uEnvK.y);
        drop = saturate(all.z);
        half3 tU = xFacing ? half3(0.0, 0.0, 1.0) : half3(1.0, 0.0, 0.0);
        N = normalize(N + (tU * all.x + half3(0.0, 1.0, 0.0) * all.y) * (half)0.9);
    }
#endif

#endif // NO_DROPS

#ifdef DISPLAY_COLOR
    half k = (half)1.0 - saturate(dot(N, V));
    half fresnel = (half)0.04 + (half)0.96 * k * k * k * k;
    half3 radiance = max(tex2D(uDisplayEnv, octUv((float3)reflect(-V, N))).rgb - uAtlasBlack.rgb, (half)0.0);
    half cover = saturate((half)uBase.a + drop * (half)0.12);
    half3 color = vColor.rgb * cover + radiance * (fresnel * ((half)1.0 + drop * (half)0.6));
#if defined(VISTA)
    color = lerp(uDisplayHaze.rgb * cover, color, uDisplayHaze.a);
#elif defined(FOG)
    color = lerp(color, uDisplayFog.rgb * cover, (half)fogFactor(dist, uFog.w));
#endif
    return half4(color, cover);
#else
    half roughness = max((half)uPbr.x, (half)0.0525);
    float alpha = roughness * roughness;
    half3 diffuseColor = (half3)uBase.rgb;
    half3 specularColor = half3(0.04, 0.04, 0.04);
    float3 diffuse = 0.0;
    float3 specular = 0.0;
#if LIGHTS > 0
    for (int i = 0; i < LIGHTS; i++) {
        float3 P = uLightPos[i].xyz;
        float3 d = vWorld - P;
        float4 R = uLightRight[i];
        float4 U = uLightUp[i];
        float3 q = P + R.xyz * clamp(dot(d, R.xyz), -R.w, R.w) + U.xyz * clamp(dot(d, U.xyz), -U.w, U.w);
        float3 Lv = q - vWorld;
        float d2 = dot(Lv, Lv);
        float3 L = Lv * rsqrt(max(d2, 1e-6));
        float s = saturate(dot(-L, uLightDir[i].xyz) * uLightDir[i].w + uLightCol[i].w);
        s = s * s * (3.0 - 2.0 * s);
        // Outside the spot cone or the range nothing is lit: skip the BRDF
        // (a passing car's headlights reach whole street chunks, lit in a
        // narrow beam).
        float att = distanceFalloff(d2 + R.w * U.w, uLightPos[i].w) * s;
        if (att > 0.0) {
            directLight(L, uLightCol[i].rgb * att, (float3)N, (float3)V, diffuseColor, specularColor, alpha, diffuse, specular);
        }
    }
#endif
    half dotNV = saturate(dot(N, V));
#ifdef BAKED
    half3 irradiance = vLight;
#else
    half3 irradiance = lerp((half3)uHemiGround.rgb, (half3)uHemiSky.rgb, N.y * 0.5 + 0.5) * (half)INV_PI;
    irradiance += tex2Dlod(uEnv, float4(octUv((float3)N), 0.0, 5.0)).rgb * (half)uEnvK.x;
#endif
    half3 radiance = tex2Dlod(uEnv, float4(octUv((float3)reflect(-V, N)), 0.0, roughness * 5.0)).rgb * (half)uEnvK.x;
#if defined(LITE) || defined(FAR)
    half k = (half)1.0 - dotNV;
    half k2 = k * k;
    half3 spec = (half3)specular + radiance * ((half)0.04 + (half)0.96 * k2 * k2);
#else
    half2 dfg = DFGApprox(roughness, dotNV);
    half3 spec = (half3)specular + radiance * (specularColor * dfg.x + dfg.y);
#endif
    half3 diff = (half3)diffuse + irradiance * diffuseColor;

    half cover = saturate((half)uBase.a + drop * (half)0.12);
    half3 color = diff * cover + spec * (1.0 + drop * (half)0.6);
#if defined(VISTA)
    color = color * vHaze.a + vHaze.rgb * cover;
#elif defined(FOG)
    half f = (half)fogFactor(dist, uFog.w);
    color = lerp(color, (half3)uFog.rgb * cover, f);
#endif
    return half4(color, cover);
#endif
}
