// Mip-blur upsample: four bilinear taps one source texel off each diagonal
// (a 4×4 tent over the coarser level), blended with this level's
// downsample by the bloom radius.

uniform sampler2D uSource;   // coarser upsampled level
uniform sampler2D uSupport;  // this level's downsample
uniform float4 uTexel;       // texel of the source, radius, -

half4 main(float2 vUv : TEXCOORD0) : COLOR
{
    float2 o = uTexel.xy;
    half3 c = tex2D(uSource, vUv + float2(-o.x, -o.y)).rgb;
    c += tex2D(uSource, vUv + float2(o.x, -o.y)).rgb;
    c += tex2D(uSource, vUv + float2(-o.x, o.y)).rgb;
    c += tex2D(uSource, vUv + float2(o.x, o.y)).rgb;
    half3 s = tex2D(uSupport, vUv).rgb;
    return half4(lerp(s, c * (half)0.25, (half)uTexel.z), 1.0);
}
