// Sun shadow depth, normalized over the orthographic light volume and
// stored directly in a 32-bit float colour target. Cut-outs retain discard.
//
// Defines: ALPHA_TEST (cut-outs: leaves, wire mesh, railings).

uniform float4 uSunDir;
uniform float4 uShadowK; // near-plane distance, inverse range, bias, size
#ifdef ALPHA_TEST
uniform sampler2D uAlbedo;
uniform float4 uBase;     // -, -, -, opacity
uniform float4 uEmissive; // -, -, -, alpha-test threshold
#endif

float4 main(
#ifdef ALPHA_TEST
    float2 vUv : TEXCOORD3,
#endif
    float3 vWorld : TEXCOORD0) : COLOR
{
#ifdef ALPHA_TEST
    if (tex2D(uAlbedo, vUv).a * uBase.a < uEmissive.w) discard;
#endif
    float d = saturate((-dot(uSunDir.xyz, vWorld) - uShadowK.x) * uShadowK.y);
    return float4(d, d, d, 1.0);
}
