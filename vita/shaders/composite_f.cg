// Final frame: scene + upsampled haze + bloom, tone mapped and graded
// through the colour table (AgX, contrast, saturation, split toning, sRGB
// encoding), then film grain and the screen mask (vignette, letterbox, dip
// to black).
//
// Defines: HAZE, BLOOM (each buffer is read only when its pass ran).

uniform sampler2D uScene;   // full-resolution HDR, alpha = eye distance
uniform sampler2D uHazeTex; // quarter resolution, bilinear
uniform sampler2D uBloom;
uniform sampler2D uLut;     // colour table (see tone)
uniform sampler2D uMask;    // vignette × letterbox × fade (frame.rs `Mask`)
uniform sampler2D uGrain;   // 64² white noise, repeated
uniform float4 uBloomK;     // bloom intensity, exposure, -, -
uniform float4 uGrade;      // haze weight, -, grain, -

// AgX, contrast, saturation, lift/gain and sRGB encoding, baked by the CPU
// into a 32³ table over AgX's log2 domain (frame.rs `tone_lut`): 32 slices
// of 32×32 side by side, blue picks the slice.
half3 tone(float3 c)
{
    float3 l = clamp((log2(max(c, 1e-10)) + 12.47393) * (31.0 / 16.5), 0.0, 31.0);
    float b0 = floor(l.b);
    float2 uv = float2((b0 * 32.0 + l.r + 0.5) / 1024.0, (l.g + 0.5) / 32.0);
    half3 lo = tex2D(uLut, uv).rgb;
    half3 hi = tex2D(uLut, uv + float2(min(b0 + 1.0, 31.0) - b0, 0.0) * (32.0 / 1024.0)).rgb;
    return lerp(lo, hi, (half)(l.b - b0));
}

// The mask and grain coordinates come straight from the vertex outputs, so
// the texture unit fetches them before the shader runs; the per-pixel
// vignette and letterbox math cost 1 ms at 480×272.
half4 main(float2 vUv : TEXCOORD0, float2 vGrain : TEXCOORD2) : COLOR
{
    half3 c = tex2D(uScene, vUv).rgb;
#ifdef HAZE
    // Haze is soft: one bilinear tap of the low-resolution buffer (a
    // bilateral 4-tap upsample cost 6.4 ms per frame on the device).
    c += tex2D(uHazeTex, vUv).rgb * (half)uGrade.x;
#endif
#ifdef BLOOM
    c += tex2D(uBloom, vUv).rgb * (half)uBloomK.x;
#endif
    half3 d = tone((float3)(c * (half)uBloomK.y));
    // Grain on the encoded colour, strongest in the shadows.
    half n = tex2D(uGrain, vGrain).r - (half)0.5;
    d += n * (half)(uGrade.z * 2.4) * ((half)1.0 - d.g * (half)0.7);
    return half4(d * tex2D(uMask, vUv).r, 1.0);
}
