// Final frame: scene + upsampled haze + bloom, tone mapped and
// graded through the colour table (AgX, contrast, saturation, split toning,
// sRGB encoding), then vignette, grain, letterbox and dip to black.

uniform sampler2D uScene;   // full-resolution HDR, alpha = eye distance
uniform sampler2D uHazeTex; // quarter resolution, bilinear
uniform sampler2D uBloom;
uniform sampler2D uLut;     // colour table (see tone)
uniform float4 uBloomK;     // intensity, exposure, time, aspect
uniform float4 uGrade;      // contrast, saturation, grain, vignette
uniform float4 uGrade2;     // fade, letterbox, resolution x, resolution y

// Interleaved gradient noise (Jimenez): film grain in four instructions.
float ign(float2 px)
{
    return frac(52.9829189 * frac(dot(px, float2(0.06711056, 0.00583715))));
}

// AgX, contrast, saturation, lift/gain and sRGB encoding, baked by the CPU
// into a 32³ table over AgX's log2 domain (frame.rs `tone_lut`): 32 slices
// of 32×32 side by side, blue picks the slice.
half3 tone(float3 c)
{
    float3 l = clamp((log2(max(c, 1e-10)) + 12.47393) * (31.0 / 16.5), 0.0, 31.0);
    float b0 = floor(l.b);
    float2 uv = float2((b0 * 32.0 + l.r + 0.5) / 1024.0, (l.g + 0.5) / 32.0);
    half3 lo = tex2D(uLut, uv).rgb;
    half3 hi = tex2D(uLut, uv + float2(min(b0 + 1.0, 31.0) - b0, 0.0) * (32.0 / 1024.0)).rgb;
    return lerp(lo, hi, (half)(l.b - b0));
}

half4 main(float2 vUv : TEXCOORD0) : COLOR
{
    half3 c = tex2D(uScene, vUv).rgb;
    // Haze is soft: one bilinear tap of the low-resolution buffer (a
    // bilateral 4-tap upsample cost 6.4 ms per frame on the device).
    c += tex2D(uHazeTex, vUv).rgb;
    c += tex2D(uBloom, vUv).rgb * (half)uBloomK.x;
    half3 d = tone((float3)(c * (half)uBloomK.y));

    // Screen-space finish on the encoded colour: vignette (scaled for the
    // sRGB curve), grain strongest in the shadows, dip to black, letterbox.
    half2 q = (half2)((vUv - 0.5) * float2(uBloomK.w, 1.0));
    half v = smoothstep((half)1.05, (half)0.25, length(q));
    d *= lerp((half)(1.0 - uGrade.w * 0.55), (half)1.0, v);
    half n = (half)ign(vUv * uGrade2.zw + frac(uBloomK.z * 7.13) * 64.0) - (half)0.5;
    d += n * (half)(uGrade.z * 2.4) * ((half)1.0 - d.g * (half)0.7);
    d *= (half)(1.0 - uGrade2.x);
    half bar = (half)(uGrade2.y * max(0.0, 0.5 - (uBloomK.w / 2.39) * 0.5));
    d *= smoothstep(bar - (half)0.001, bar + (half)0.001, (half)min(vUv.y, 1.0 - vUv.y));
    return half4(d, 1.0);
}
