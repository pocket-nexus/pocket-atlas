// Interface quad in display pixels (960×544, top-left origin): rounded
// rectangles, gradients and images over the presented frame.

void main(
    float2 aPosition,       // corner, 0..1
    uniform float4 uRect,   // x0, y0, x1, y1 (pixels)
    uniform float4 uLocal,  // the same corners relative to the shape's centre
    uniform float4 uTexRect, // u0, v0, u1, v1
    out float4 oPosition : POSITION,
    out float2 oLocal : TEXCOORD0,
    out float2 oUv : TEXCOORD1)
{
    float2 p = lerp(uRect.xy, uRect.zw, aPosition);
    oPosition = float4(p.x / 480.0 - 1.0, 1.0 - p.y / 272.0, 0.5, 1.0);
    oLocal = lerp(uLocal.xy, uLocal.zw, aPosition);
    oUv = lerp(uTexRect.xy, uTexRect.zw, aPosition);
}
