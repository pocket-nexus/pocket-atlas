// Vertex stage for every mesh material. Positions arrive quantised (s16n)
// and are dequantised by uModel, which also carries the node transform for
// rigid moving parts. Skinned vertices blend up to four bone rows. Baked
// vertices carry the static diffuse lighting as square-root RGBM.
//
// Defines: SKINNED, MAX_BONES, BAKED; which varyings the fragment program
// reads beyond world position, normal and UV: TANGENT, COLOR, SCREEN.
// WAVES (water): the UV and a second set are the world's x/z plane in two
// wave layers (repeats per metre, scroll offset) instead of the mesh UV.
// VERTEX_LIGHTS=n: diffuse irradiance from n lights per vertex (moving and
// skinned meshes are dense enough), in the baked lighting varying.
// VISTA: the vista haze per vertex (vista.cgh), (inscatter · (1 − T), T).
// FLAT (profiling) writes position and world only.

#if defined(VISTA) && !defined(FLAT)
#include "vista.cgh"
#endif

void main(
    float4 aPosition,
    float4 aNormal,
    float4 aTangent,
    float2 aUv,
    float4 aColor,
#ifdef SKINNED
    float4 aJoints,
    float4 aWeights,
    uniform float4 uBones[3 * MAX_BONES],
#endif
#if defined(BAKED) && !defined(FLAT)
    float4 aLight,
    out half3 oLight : TEXCOORD5,
#endif
#if defined(VERTEX_LIGHTS) && !defined(FLAT)
    uniform float4 uLightPos[VERTEX_LIGHTS],   // position, 1 / range
    uniform float4 uLightCol[VERTEX_LIGHTS],   // radiant intensity, spot offset
    uniform float4 uLightDir[VERTEX_LIGHTS],   // emission direction, spot scale
    uniform float4 uLightRight[VERTEX_LIGHTS], // rect width axis, half width
    uniform float4 uLightUp[VERTEX_LIGHTS],    // rect height axis, half height
    out half3 oLight : TEXCOORD5,
#endif
    uniform float4 uModel[3],
    uniform float4 uDequant[2],
    uniform float4x4 uViewProj,
    uniform float4 uUv,
#ifdef WAVES
    uniform float4 uWave[2], // repeats per metre, -, offset
    out float2 oUv2 : TEXCOORD6,
#endif
#if defined(VISTA) && !defined(FLAT)
    uniform float4 uEye,
    out half4 oHaze : TEXCOORD7,
#endif
#if defined(SUN) && !defined(FLAT)
    uniform float4 uSunMat[2],
    uniform float4 uSunDir,
    uniform float4 uSunRad,
    uniform float4 uShadowK,
    out float3 oShadow : TEXCOORD6,
#endif
    out float4 oPosition : POSITION,
#ifndef FLAT
    out half3 oNormal : TEXCOORD1,
    out float2 oUv : TEXCOORD3,
#ifdef TANGENT
    out half4 oTangent : TEXCOORD2,
#endif
#ifdef SCREEN
    out float4 oScreen : TEXCOORD4,
#endif
#ifdef COLOR
    out half4 oColor : COLOR0,
#endif
#endif
    out float3 oWorld : TEXCOORD0)
{
    float4 local = float4(aPosition.xyz * uDequant[0].xyz + uDequant[1].xyz, 1.0);
    float3 n = aNormal.xyz;
    float3 t = aTangent.xyz;
#ifdef SKINNED
    float3 sp = 0.0;
    float3 sn = 0.0;
    float3 st = 0.0;
    for (int k = 0; k < 4; k++) {
        int j = (int)aJoints[k] * 3;
        float w = aWeights[k];
        float4 r0 = uBones[j];
        float4 r1 = uBones[j + 1];
        float4 r2 = uBones[j + 2];
        sp += w * float3(dot(r0, local), dot(r1, local), dot(r2, local));
        sn += w * float3(dot(r0.xyz, n), dot(r1.xyz, n), dot(r2.xyz, n));
        st += w * float3(dot(r0.xyz, t), dot(r1.xyz, t), dot(r2.xyz, t));
    }
    local = float4(sp, 1.0);
    n = sn;
    t = st;
#endif
    float3 world = float3(dot(uModel[0], local), dot(uModel[1], local), dot(uModel[2], local));
    n = float3(dot(uModel[0].xyz, n), dot(uModel[1].xyz, n), dot(uModel[2].xyz, n));
    t = float3(dot(uModel[0].xyz, t), dot(uModel[1].xyz, t), dot(uModel[2].xyz, t));
    float4 clipPos = mul(uViewProj, float4(world, 1.0));
    oPosition = clipPos;
    oWorld = world;
#ifndef FLAT
    oNormal = (half3)normalize(n);
#ifdef SUN
    // The sun projection is affine. Interpolating its result removes
    // three world-space dot products from every shaded fragment.
    float3 shadowWorld = world + normalize(n) * uSunRad.w;
    float4 sw = float4(shadowWorld, 1.0);
    oShadow = float3(dot(uSunMat[0], sw), dot(uSunMat[1], sw),
        (-dot(uSunDir.xyz, shadowWorld) - uShadowK.x) * uShadowK.y);
#endif
#ifdef WAVES
    oUv = world.xz * uWave[0].x + uWave[0].zw;
    oUv2 = world.xz * uWave[1].x + uWave[1].zw;
#else
    oUv = aUv * uUv.xy + uUv.zw;
#endif
#ifdef TANGENT
    oTangent = half4((half3)normalize(t), (half)aTangent.w);
#endif
#ifdef SCREEN
    oScreen = clipPos;
#endif
#ifdef COLOR
    oColor = (half4)aColor;
#endif
#ifdef VISTA
    oHaze = vistaHaze(world, uEye.xyz);
#endif
#endif
#if defined(BAKED) && !defined(FLAT)
    float3 s = aLight.rgb * aLight.a;
    oLight = (half3)(s * s * 64.0);
#endif
#if defined(VERTEX_LIGHTS) && !defined(FLAT)
    {
        // As the fragment programs' lights (closest point of rect emitters,
        // spot cone, three's distance falloff), Lambert only, over π.
        float3 nw = normalize(n);
        float3 acc = 0.0;
        for (int i = 0; i < VERTEX_LIGHTS; i++) {
            float3 P = uLightPos[i].xyz;
            float3 d = world - P;
            float4 R = uLightRight[i];
            float4 U = uLightUp[i];
            float3 q = P + R.xyz * clamp(dot(d, R.xyz), -R.w, R.w) + U.xyz * clamp(dot(d, U.xyz), -U.w, U.w);
            float3 Lv = q - world;
            float d2 = dot(Lv, Lv);
            float3 L = Lv * rsqrt(max(d2, 1e-6));
            float sp = saturate(dot(-L, uLightDir[i].xyz) * uLightDir[i].w + uLightCol[i].w);
            sp = sp * sp * (3.0 - 2.0 * sp);
            float dr = d2 + R.w * U.w;
            float x = dr * uLightPos[i].w * uLightPos[i].w;
            float w = saturate(1.0 - x * x);
            acc += uLightCol[i].rgb * (w * w * sp * saturate(dot(nw, L)) / max(dr, 0.01));
        }
        oLight = (half3)(acc * 0.31830989);
    }
#endif
}
