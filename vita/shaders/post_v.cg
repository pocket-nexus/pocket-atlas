// Full-screen triangle for post passes: texture UV (v down) and the world
// view ray of each corner.

void main(
    float2 aPosition,
    uniform float4 uRayZ,
    uniform float4 uRayX,
    uniform float4 uRayY,
    out float4 oPosition : POSITION,
    out float2 oUv : TEXCOORD0,
    out float3 oRay : TEXCOORD1)
{
    oPosition = float4(aPosition, 0.5, 1.0);
    oUv = float2(aPosition.x * 0.5 + 0.5, 0.5 - aPosition.y * 0.5);
    oRay = uRayZ.xyz + uRayX.xyz * aPosition.x + uRayY.xyz * aPosition.y;
}
