// Plain float positions in world space (generated meshes: the rain curtain).

void main(
    float3 aPosition,
    uniform float4x4 uViewProj,
    uniform float4 uOffset,
    out float4 oPosition : POSITION,
    out float3 oWorld : TEXCOORD0)
{
    float3 w = aPosition + uOffset.xyz;
    oPosition = mul(uViewProj, float4(w, 1.0));
    oWorld = w;
}
